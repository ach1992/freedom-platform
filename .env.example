APP_NAME="Freedom Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# APP_VERSION is optional locally; release/deployment should set the exact release identifier when needed.

APP_TIMEZONE=UTC
BUSINESS_TIMEZONE=Asia/Tehran

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr,daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=freedom_platform
DB_USERNAME=freedom_platform
DB_PASSWORD=

# Dedicated MariaDB PROCESS-only principal for Telegram FK metadata attestation.
# Never reuse DB_USERNAME here. TELEGRAM_METADATA_DB_URL is optional and must target the same MariaDB server.
TELEGRAM_METADATA_DB_URL=
TELEGRAM_METADATA_DB_USERNAME=
TELEGRAM_METADATA_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=freedom_platform

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_RETRY_AFTER=420
REDIS_QUEUE_BLOCK_FOR=5

# Supervisor overrides these per queue worker process.
WORKER_HEARTBEAT_ENABLED=false
WORKER_NAME=
WORKER_QUEUE_GROUP=default
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_HEARTBEAT_STALE_AFTER_SECONDS=480

PHONE_LOOKUP_KEY=
PHONE_LOOKUP_KEY_VERSION=1
IDENTITY_ITEM_HASH_KEY_VERSION=1
OTP_HASH_KEY=
OTP_HASH_KEY_VERSION=1
OTP_TTL_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAXIMUM_ATTEMPTS=5
OTP_DAILY_PHONE_LIMIT=10
OTP_DAILY_TELEGRAM_ACCOUNT_LIMIT=10
OTP_DAILY_IP_LIMIT=20
OTP_REDIS_PREFIX=freedom:otp-limit:

BENEFIT_CODE_LOOKUP_KEY_CURRENT_VERSION=1
BENEFIT_CODE_LOOKUP_KEY_CURRENT=
BENEFIT_CODE_LOOKUP_KEY_PREVIOUS_VERSION=
BENEFIT_CODE_LOOKUP_KEY_PREVIOUS=

# Real SMS providers stay disabled until credentials are supplied through a protected environment.
SMS_PRIMARY_PROVIDER=fake_primary
SMS_FALLBACK_PROVIDER=fake_fallback
SMS_PROVIDER_DAILY_LIMIT=10000
SMS_PROVIDER_TIMEOUT_SECONDS=15
MELLI_PAYAMAK_ENABLED=false
MELLI_PAYAMAK_USERNAME=
MELLI_PAYAMAK_PASSWORD=
MELLI_PAYAMAK_SENDER=
MELLI_PAYAMAK_TIMEOUT_SECONDS=15
KAVENEGAR_ENABLED=false
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_TIMEOUT_SECONDS=15

# Real payment providers stay disabled until credentials are supplied through a protected environment.
ZARINPAL_ENABLED=false
ZARINPAL_MERCHANT_ID=
ZARINPAL_CALLBACK_URL=http://localhost:8000/payments/zarinpal/callback
ZARINPAL_CONNECT_TIMEOUT_SECONDS=5
ZARINPAL_TIMEOUT_SECONDS=15

NOWPAYMENTS_ENABLED=false
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Must be a server-controlled public HTTPS URL when NOWPayments is enabled.
NOWPAYMENTS_IPN_CALLBACK_URL=
# Exact NOWPayments pay_currency code is deployment/business configuration; do not infer it from asset names.
NOWPAYMENTS_PAY_CURRENCY=
NOWPAYMENTS_CONNECT_TIMEOUT_SECONDS=5
NOWPAYMENTS_TIMEOUT_SECONDS=15
NOWPAYMENTS_MAX_RESPONSE_BYTES=262144
NOWPAYMENTS_MAX_IPN_BODY_BYTES=262144

# Generate deployment-specific secrets with at least 32 bytes/characters; never commit real values.
C2C_LOOKUP_KEY=
C2C_RESERVATION_MINUTES=30
C2C_LATE_REVIEW_MINUTES=1440
C2C_ADJUSTMENT_MIN_IRR=1000
C2C_ADJUSTMENT_MAX_IRR=9990

GIFT_CARD_CODE_LOOKUP_KEY=
GIFT_CARD_CODE_LOOKUP_KEY_VERSION=1
# During rotation, keep the immediately previous key/version configured.
GIFT_CARD_CODE_LOOKUP_PREVIOUS_KEY=
GIFT_CARD_CODE_LOOKUP_PREVIOUS_KEY_VERSION=
# JSON object of older immutable lookup-key versions to protected secrets, e.g. {"1":"<secret>"}.
# Keep every retired key version that can still exist on an immutable gift-card submission.
GIFT_CARD_CODE_LOOKUP_HISTORICAL_KEYS_JSON=

# USDT rate sourcing defaults to Nobitex then public Wallex USDTTMN market data.
# The managed DB setting is the normal operator-controlled Manual rate. This env value is bootstrap only
# until the first protected managed setting is saved. Manual fallback is used only when explicitly enabled.
USDT_RATE_SIDE=buy
USDT_RATE_MAX_AGE_SECONDS=120
USDT_RATE_MIN_IRR=100000
USDT_RATE_MAX_IRR=10000000
USDT_RATE_MAX_DIVERGENCE_BPS=500
USDT_EMERGENCY_MANUAL_FALLBACK=false
USDT_MANUAL_RATE_IRR=
USDT_RATE_CIRCUIT_FAILURE_THRESHOLD=3
USDT_RATE_CIRCUIT_COOLDOWN_SECONDS=60
USDT_RATE_HTTP_TIMEOUT_SECONDS=4
USDT_RATE_HTTP_CONNECT_TIMEOUT_SECONDS=2
USDT_RATE_HTTP_MAX_RESPONSE_BYTES=65536
USDT_QUOTE_MARGIN_BPS=0
USDT_QUOTE_ROUNDING_PRECISION=6
USDT_QUOTE_VALIDITY_SECONDS=900
USDT_DESTINATION_WALLET_CODE=primary

# Binance-curated USDT on BNB Smart Chain (BEP20), chain ID 56. Public token metadata; not a secret.
USDT_BEP20_CHAIN_ID=56
USDT_BEP20_TOKEN_CONTRACT=0x55d398326f99059ff775485246999027b3197955
USDT_BEP20_TOKEN_DECIMALS=18
USDT_BEP20_MINIMUM_CONFIRMATIONS=15
USDT_BEP20_GENERIC_REST_TIMEOUT_SECONDS=10
USDT_BEP20_GENERIC_REST_MAX_BODY_BYTES=262144

AGENT_REAPPLICATION_COOLDOWN_DAYS=30
AGENT_DEFAULT_PRICING_PROFILE_CODE=default

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PATH=api/telegram/webhook
TELEGRAM_WEBHOOK_MAX_BODY_BYTES=1048576
TELEGRAM_WEBHOOK_QUEUE=telegram-ingress
TELEGRAM_PROCESSING_LEASE_SECONDS=120
TELEGRAM_INTERACTION_SESSION_TTL_SECONDS=1800
TELEGRAM_INTERACTION_CALLBACK_TTL_SECONDS=900
TELEGRAM_API_TIMEOUT_SECONDS=15
OWNER_TELEGRAM_ID=
REPORT_CHAT_ID=

# Override with absolute shared paths in production release deployments.
# INSTALLER_LOCK_PATH=/www/acdomains/hell.hellpservice.ir/shared/installer.lock
# INSTALLER_ACCESS_FILE=/www/acdomains/hell.hellpservice.ir/shared/installer-access.json
# INSTALLER_BOOTSTRAP_JOURNAL_PATH=/www/acdomains/hell.hellpservice.ir/shared/installer-bootstrap.json
# INSTALLER_ENVIRONMENT_PATH=/www/acdomains/hell.hellpservice.ir/shared/.env
# INSTALLER_ENVIRONMENT_SNAPSHOT_PATH=/www/acdomains/hell.hellpservice.ir/shared/installer-environment.snapshot
INSTALLER_PHP_CLI_BINARY=/www/server/php/84/bin/php
INSTALLER_PHP_LSPHP_BINARY=/usr/local/lsws/lsphp84/bin/lsphp
INSTALLER_FINALIZATION_TIMEOUT_SECONDS=300
INSTALLER_MINIMUM_FREE_BYTES=1073741824
INSTALLER_EXPECTED_OWNER=www
INSTALLER_EXPECTED_GROUP=www

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Service auto-renew scheduler, fresh-Quote policy and bounded retry.
AUTO_RENEW_WINDOW_HOURS=24
AUTO_RENEW_QUOTE_TTL_MINUTES=15
AUTO_RENEW_BATCH_LIMIT=50
AUTO_RENEW_MAX_RETRY_COUNT=5
AUTO_RENEW_RETRY_INITIAL_DELAY_MINUTES=15
AUTO_RENEW_RETRY_MAX_DELAY_MINUTES=240

# Service synchronization scheduler, durable observation lease and anomaly severity policy.
SERVICE_SYNC_INTERVAL_MINUTES=5
SERVICE_SYNC_BATCH_LIMIT=50
SERVICE_SYNC_LEASE_SECONDS=120
SERVICE_SYNC_SEVERITY_MISSING_REMOTE=critical
SERVICE_SYNC_SEVERITY_EXPIRED_ACTIVE=warning
SERVICE_SYNC_SEVERITY_LIFECYCLE_MISMATCH=warning
SERVICE_SYNC_SEVERITY_IDENTITY_MISMATCH=critical
SERVICE_SYNC_SEVERITY_UNEXPECTED_ENTITLEMENT=warning

# Service notification thresholds and bounded Telegram delivery retry.
SERVICE_NOTIFICATION_INTERVAL_MINUTES=5
SERVICE_NOTIFICATION_BATCH_LIMIT=50
SERVICE_NOTIFICATION_EXPIRY_DAYS=7,3,1,0
# Fresh Service-sync evidence is required for new/queued/sent expiry notifications; 1800 = 30 minutes.
SERVICE_NOTIFICATION_EXPIRY_SNAPSHOT_MAX_AGE_SECONDS=1800
# 0 disables low-balance warnings until an explicit IRR threshold is configured.
SERVICE_NOTIFICATION_LOW_BALANCE_IRR=0
SERVICE_NOTIFICATION_EXPIRY_MAX_RETRIES=2
SERVICE_NOTIFICATION_EXPIRY_RETRY_BASE_SECONDS=60
SERVICE_NOTIFICATION_EXPIRY_RETRY_MAX_SECONDS=900
SERVICE_NOTIFICATION_LOW_BALANCE_MAX_RETRIES=2
SERVICE_NOTIFICATION_LOW_BALANCE_RETRY_BASE_SECONDS=120
SERVICE_NOTIFICATION_LOW_BALANCE_RETRY_MAX_SECONDS=1800
SERVICE_NOTIFICATION_RENEWAL_MAX_RETRIES=3
SERVICE_NOTIFICATION_RENEWAL_RETRY_BASE_SECONDS=60
SERVICE_NOTIFICATION_RENEWAL_RETRY_MAX_SECONDS=1800
