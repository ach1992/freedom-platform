APP_NAME="Freedom Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=0.2.0-dev

APP_TIMEZONE=UTC
BUSINESS_TIMEZONE=Asia/Tehran

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr,daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=freedom_platform
DB_USERNAME=freedom_platform
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=freedom_platform

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_RETRY_AFTER=420
REDIS_QUEUE_BLOCK_FOR=5

# Supervisor overrides these per queue worker process.
WORKER_HEARTBEAT_ENABLED=false
WORKER_NAME=
WORKER_QUEUE_GROUP=default
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_HEARTBEAT_STALE_AFTER_SECONDS=480

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PATH=api/telegram/webhook
TELEGRAM_WEBHOOK_MAX_BODY_BYTES=1048576
TELEGRAM_WEBHOOK_QUEUE=telegram-ingress
TELEGRAM_PROCESSING_LEASE_SECONDS=120
TELEGRAM_API_TIMEOUT_SECONDS=15
OWNER_TELEGRAM_ID=
REPORT_CHAT_ID=

# Override with absolute shared paths in production release deployments.
# INSTALLER_LOCK_PATH=/www/acdomains/hell.hellpservice.ir/shared/installer.lock
# INSTALLER_ACCESS_FILE=/www/acdomains/hell.hellpservice.ir/shared/installer-access.json
# INSTALLER_BOOTSTRAP_JOURNAL_PATH=/www/acdomains/hell.hellpservice.ir/shared/installer-bootstrap.json
# INSTALLER_ENVIRONMENT_PATH=/www/acdomains/hell.hellpservice.ir/shared/.env
# INSTALLER_ENVIRONMENT_SNAPSHOT_PATH=/www/acdomains/hell.hellpservice.ir/shared/installer-environment.snapshot
INSTALLER_PHP_CLI_BINARY=/www/server/php/84/bin/php
INSTALLER_PHP_LSPHP_BINARY=/usr/local/lsws/lsphp84/bin/lsphp
INSTALLER_FINALIZATION_TIMEOUT_SECONDS=300
INSTALLER_MINIMUM_FREE_BYTES=1073741824
INSTALLER_EXPECTED_OWNER=www
INSTALLER_EXPECTED_GROUP=www

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
