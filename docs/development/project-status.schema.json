{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/freedom-platform/project-status.schema.json",
  "title": "Freedom Platform Project Status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "last_reviewed",
    "target_release",
    "repository",
    "authoritative_pr",
    "authoritative_issue",
    "allowed_branch",
    "base_branch",
    "required_pr_state",
    "live_head_source",
    "active_phase",
    "last_verified_boundary",
    "active_increment",
    "stabilization",
    "forbidden_actions"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "last_reviewed": { "type": "string", "format": "date" },
    "target_release": { "const": "1.0.0" },
    "repository": { "const": "ach1992/freedom-platform" },
    "authoritative_pr": { "const": 6 },
    "authoritative_issue": { "const": 8 },
    "allowed_branch": { "const": "develop/v1.0.0-completion" },
    "base_branch": { "const": "main" },
    "required_pr_state": { "const": "draft" },
    "live_head_source": { "const": "github_pr_head_sha" },
    "active_phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "name", "status"],
      "properties": {
        "version": { "pattern": "^0\\.[0-9]+\\.0$" },
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["planned", "active", "verified", "closed"] }
      }
    },
    "last_verified_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "implementation_sha",
        "implementation_ci_run_id",
        "implementation_ci_run_number",
        "evidence_sha",
        "evidence_ci_run_id",
        "evidence_ci_run_number",
        "tests",
        "assertions",
        "artifact_name",
        "artifact_id",
        "artifact_sha256",
        "evidence_path",
        "traceability_path"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "implementation_sha": { "$ref": "#/$defs/sha" },
        "implementation_ci_run_id": { "type": "integer", "minimum": 1 },
        "implementation_ci_run_number": { "type": "integer", "minimum": 1 },
        "evidence_sha": { "$ref": "#/$defs/sha" },
        "evidence_ci_run_id": { "type": "integer", "minimum": 1 },
        "evidence_ci_run_number": { "type": "integer", "minimum": 1 },
        "tests": { "type": "integer", "minimum": 1 },
        "assertions": { "type": "integer", "minimum": 1 },
        "artifact_name": { "type": "string", "minLength": 1 },
        "artifact_id": { "type": "integer", "minimum": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "evidence_path": { "$ref": "#/$defs/repositoryPath" },
        "traceability_path": { "$ref": "#/$defs/repositoryPath" }
      }
    },
    "active_increment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "handoff_path", "requirements"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["planned", "active", "unverified", "blocked", "verified"] },
        "handoff_path": { "$ref": "#/$defs/repositoryPath" },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" }
        }
      }
    },
    "stabilization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "feature_development_paused", "exit_conditions"],
      "properties": {
        "status": { "enum": ["inactive", "active", "blocked", "complete"] },
        "feature_development_paused": { "type": "boolean" },
        "exit_conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
        }
      }
    },
    "forbidden_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    }
  }
}
