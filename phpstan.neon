includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 7
    paths:
        - app
        - bootstrap
        - config
        - database
        - routes
    tmpDir: build/cache/phpstan
    treatPhpDocTypesAsCertain: false
    typeAliases:
        ServiceFacts: "object{id: int|string, public_id: string, user_id: int|string, account_type: string, plan_offering_id: int|string, service_target_id: int|string|null, remote_service_id: string|null, provisioned_at: string|null, lifecycle_state: string, lifecycle_version: int|string, remote_identity_generation: int|string, remote_deleted_at: string|null, offering_state: string, auto_renew_allowed: int|bool|string}"
        ServiceAutoRenewConfigurationFacts: "object{config_id: int|string, service_subscription_id: int|string, renewal_package_id: int|string, enabled: int|bool|string, accepted_price_irr: int|string, last_settled_price_irr: int|string|null, observed_expires_at: string|null, expiry_observed_at: string|null, observed_expiry_evidence_hash: string|null, observed_expiry_source: string|null, observed_remote_identity_generation: int|string|null, configuration_version: int|string, service_public_id: string, user_id: int|string, account_type: string, plan_offering_id: int|string, service_target_id: int|string|null, remote_service_id: string|null, provisioned_at: string|null, lifecycle_state: string, lifecycle_version: int|string, remote_identity_generation: int|string, remote_deleted_at: string|null, offering_state: string, auto_renew_allowed: int|bool|string, package_code: string, package_type: string, package_duration_days: int|string|null}"
        ServiceAutoRenewAttemptRow: "object{id: int|string, public_id: string, cycle_key: string, auto_renew_configuration_id: int|string, service_subscription_id: int|string, configuration_version: int|string, remote_identity_generation: int|string, observed_expires_at: string, observed_expiry_evidence_hash: string, observed_expiry_source: string, state: string, reason_code: string|null, baseline_price_irr: int|string, current_price_irr: int|string|null, quote_id: int|string|null, payment_eligibility_decision_id: int|string|null, payment_intent_id: int|string|null, purchase_settlement_id: int|string|null, provisioning_operation_id: int|string|null, correlation_id: string, commercial_generation: int|string, retry_count: int|string, next_retry_at: string|null, completed_at: string|null}"
        ServiceAutoRenewPaymentIntentRow: "object{id: int|string, public_id: string, state: string}"
